# Global Settings
max-history=20
layer=overlay
anchor=top-right
font=JetBrains Mono Nerd Font 10
format=<b>%s</b>\n%b
markup=1
actions=true
icons=1
max-icon-size=64
default-timeout=10000
ignore-timeout=0
width=300
height=300
margin=20
padding=10
border-size=2
border-radius=12

# Colors generated dynamically by Matugen
background-color=#111318e6
text-color=#e1e2e9
border-color=#a5c8ff

# Low Urgency
[urgency=low]
background-color=#191c20e6
text-color=#e1e2e9
border-color=#8d9199
default-timeout=5000

# Normal Urgency
[urgency=normal]
background-color=#1d2024e6
text-color=#e1e2e9
border-color=#a5c8ff
default-timeout=10000

# Critical Urgency
[urgency=critical]
background-color=#282a2fe6
text-color=#e1e2e9
border-color=#ffb4ab
default-timeout=0
