# Global Settings
max-history=20
layer=overlay
anchor=top-right
font=JetBrains Mono Nerd Font 10
format=<b>%s</b>\n%b
markup=1
actions=true
icons=1
max-icon-size=64
default-timeout=10000
ignore-timeout=0
width=300
height=300
margin=20
padding=10
border-size=2
border-radius=12

# Colors generated dynamically by Matugen
background-color=#0f1417e6
text-color=#dfe3e7
border-color=#90cef4

# Low Urgency
[urgency=low]
background-color=#181c1fe6
text-color=#dfe3e7
border-color=#8b9297
default-timeout=5000

# Normal Urgency
[urgency=normal]
background-color=#1c2023e6
text-color=#dfe3e7
border-color=#90cef4
default-timeout=10000

# Critical Urgency
[urgency=critical]
background-color=#262b2ee6
text-color=#dfe3e7
border-color=#ffb4ab
default-timeout=0
